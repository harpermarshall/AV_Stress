# 4. Compute CDF per offset × condition
cdf_df <- df2 %>%
group_by(offset_corrected, modality) %>%
summarize(
rt_bin = list(rt_grid),
prob   = list(ecdf(rt)(rt_grid)),
.groups = "drop"
) %>%
unnest(c(rt_bin, prob))
# 5. Pivot wider and add Miller’s bound
race_df <- cdf_df %>%
pivot_wider(names_from = modality, values_from = prob) %>%
mutate(
MillerBound = pmin(A + V, 1)
) %>%
select(offset_corrected, rt_bin, A, V, AVC, MillerBound) %>%
pivot_longer(
cols      = c(A, V, AVC, MillerBound),
names_to  = "condition",
values_to = "prob"
)
# 6. Plot
ggplot(race_df, aes(x = rt_bin, y = prob, color = condition, linetype = condition)) +
geom_line(size = 0.5) +
facet_wrap(~ offset_corrected, ncol = 4) +
scale_color_manual(
values = c(
A           = "red",
V           = "blue",
AVC         = "green",
MillerBound = "black"
),
labels = c("A", "V", "AVC", "Miller’s Bound")
) +
scale_linetype_manual(
values = c("solid", "solid", "solid", "dotted"),
labels = c("A", "V", "AVC", "Miller’s Bound")
) +
coord_cartesian(xlim = c(250, 800), ylim = c(0, 1)) +
labs(
x     = "Reaction Time (ms)",
y     = "Cumulative Probability",
title = "CDFs & Miller’s Race‐Model Bound by Offset"
) +
