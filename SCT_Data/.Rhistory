library(ggplot2)
library(dplyr)
library(rstatix)
library(ggsignif)
# 1️⃣ Create factor version of offset for consistent dodging
accuracy_summary <- accuracy_summary %>%
mutate(offset_f = factor(offset_corrected, levels = sort(unique(offset_corrected))))
accuracy_by_participant <- accuracy_by_participant %>%
mutate(offset_f = factor(offset_corrected, levels = levels(accuracy_summary$offset_f)))
# 2️⃣ Prep pairwise_ready with numeric x‐positions & y‐positions
pairwise_ready <- pairwise_results %>%
mutate(
offset_f = factor(offset_corrected, levels = levels(accuracy_summary$offset_f)),
offset_num = as.numeric(offset_f),
xmin       = offset_num - 0.3 + ifelse(comparison=="AVC vs V", 0.4, 0),
xmax       = xmin,
y_position = 1.005 + 0.02*(offset_num-1)
)
# 3️⃣ Plot
ggplot(accuracy_summary, aes(x = offset_f, y = accuracy, fill = modality)) +
geom_col(position = position_dodge(0.8), width = 0.7) +
stat_summary(
aes(group = modality),
fun.data = mean_se,
geom = "errorbar",
position = position_dodge(0.8),
width = 0.2
) +
geom_signif(
inherit.aes = FALSE,
data       = pairwise_ready,
mapping    = aes(
xmin        = xmin,
xmax        = xmax,
annotations = label,    # ← plural here
y_position  = y_position
),
manual     = TRUE,
tip_length = 0.02,
textsize   = 4
) +
scale_fill_manual(
name   = "Modality",
values = c("A"   = "blue",
"V"   = "red",
"AVC" = "green"),
labels = c("Audio", "Visual", "Audio-Visual")
