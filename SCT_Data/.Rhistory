# Helper: compute empirical CDF within a grouping
get_ecdf_df <- function(df) {
df %>%
arrange(rt_corrected) %>%
mutate(cdf = seq_along(rt_corrected) / n())
}
# Helper: build Miller bound F_A(t) + F_V(t)
get_miller_bound <- function(ecdf_df) {
A <- ecdf_df %>% filter(modality == "A")
V <- ecdf_df %>% filter(modality == "V")
t_grid <- sort(unique(c(A$rt_corrected, V$rt_corrected)))
FA <- approxfun(A$rt_corrected, A$cdf,
method = "constant", yleft = 0, yright = 1, f = 1)
FV <- approxfun(V$rt_corrected, V$cdf,
method = "constant", yleft = 0, yright = 1, f = 1)
tibble(
rt_corrected = t_grid,
cdf          = FA(t_grid) + FV(t_grid)
)
}
# Get all unique offsets
offsets <- sort(unique(total_df$offset_corrected))
# Loop over each offset
for(off in offsets) {
df_off <- total_df %>% filter(offset_corrected == off)
# Group-level ECDFs by modality
group_ecdf <- df_off %>%
group_by(modality) %>%
get_ecdf_df() %>%
ungroup()
# Miller bound at this offset
miller_grp <- get_miller_bound(group_ecdf)
# Plot
p <- ggplot() +
geom_line(data = filter(group_ecdf, modality == "A"),
aes(rt_corrected, cdf, color = "A"), linewidth = 0.5) +
geom_line(data = filter(group_ecdf, modality == "V"),
aes(rt_corrected, cdf, color = "V"), linewidth = 0.5) +
geom_line(data = filter(group_ecdf, modality == "AVC"),
aes(rt_corrected, cdf, color = "AVC"), linewidth = 0.5) +
geom_line(data = miller_grp,
aes(rt_corrected, cdf),
color = "black", linetype = "dotted", linewidth = 0.5) +
scale_color_manual(values = c("A" = "red",
"V" = "blue",
"AVC" = "green")) +
labs(title = paste0("Group CDFs — Offset ", off, " ms"),
x     = "RT (ms)",
y     = "CDF",
color = "Modality") +
theme_minimal()
print(p)
}
# 1. define your bins
bins <- seq(250, 800, by = 20)
# 2. helpers to compute binned-CDFs
compute_binned_cdf <- function(rts, bins) {
sapply(bins, function(b) mean(rts <= b))
}
# 3. loop over each offset
offsets <- sort(unique(total_df$offset_corrected))
for (off in offsets) {
df_off <- total_df %>% filter(offset_corrected == off)
# 3a. compute CDFs for each modality at each bin
cdf_df <- df_off %>%
group_by(modality) %>%
summarize(
rt_list = list(rt_corrected),
n       = n(),
.groups = "drop"
) %>%
mutate(
bin_cdf = map(rt_list, ~ tibble(
rt_bin = bins,
cdf    = compute_binned_cdf(.x, bins)
))
) %>%
select(modality, bin_cdf) %>%
unnest(bin_cdf)
# 3b. build Miller bound (A + V) at each bin
miller_df <- cdf_df %>%
filter(modality %in% c("A","V")) %>%
pivot_wider(names_from = modality, values_from = cdf) %>%
mutate(cdf = A + V) %>%
select(rt_bin, cdf)
# 3c. plot
p <- ggplot() +
geom_line(data = filter(cdf_df, modality == "A"),
aes(rt_bin, cdf, color = "A"), linewidth = 0.5) +
geom_line(data = filter(cdf_df, modality == "V"),
aes(rt_bin, cdf, color = "V"), linewidth = 0.5) +
geom_line(data = filter(cdf_df, modality == "AVC"),
aes(rt_bin, cdf, color = "AVC"), linewidth = 0.5) +
geom_line(data = miller_df,
aes(rt_bin, cdf),
color = "black", linetype = "dotted", linewidth = 0.5) +
scale_color_manual(values = c("A"   = "red",
"V"   = "blue",
"AVC" = "green"),
name = "Modality") +
labs(title = paste0("Group CDFs — Offset ", off, " ms"),
x     = "RT bin (ms)",
y     = "CDF") +
theme_minimal()
print(p)
}
