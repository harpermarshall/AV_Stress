A          = ecdf_A(times),
V          = ecdf_V(times),
AVC        = ecdf_AVC(times),
RaceBound  = pmin(ecdf_A(times) + ecdf_V(times), 1)  # Miller bound
)
}) %>%
ungroup() %>%
pivot_longer(
cols      = c(A, V, AVC, RaceBound),
names_to  = "condition",
values_to = "prob"
)
# Plot
ggplot(plot_data, aes(x = rt, y = prob, color = modality, linetype = modality)) +
geom_line(size = 0.5) +
facet_wrap(~ offset, ncol = 4) +                   # 4 across → 2nd row has 3
scale_color_manual(
values = c(
A         = "red",
V         = "blue",
AVC       = "green",
RaceBound = "black"
)
) +
scale_linetype_manual(
values = c(
A         = "solid",
V         = "solid",
AVC       = "solid",
RaceBound = "dotted"
)
) +
coord_cartesian(xlim = c(250, 800), ylim = c(0, 1)) +
labs(
x     = "Reaction Time (ms)",
y     = "Cumulative Probability",
title = "CDFs and Miller’s (Race‐Model) Bound by Offset"
) +
theme_minimal() +
theme(
strip.text = element_text(face = "bold"),
legend.title = element_blank()
)
