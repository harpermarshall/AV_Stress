axis.text.x   = element_text(angle = 45, hjust = 1)
)
# 2. DEFINE RT BINS (250–2000 ms in 10-ms steps)
rt_bins <- seq(250, 2000, by = 10)
# 3. GET EACH PARTICIPANT’S CDF FOR A, V, AVC
cdf_indiv <- clean_df %>%
filter(modality %in% c("A","V","AVC")) %>%     # only those three conditions
group_by(participant_number, offset_corrected, modality) %>%
summarise(
rt_bin = list(rt_bins),                       # our grid of times
prob   = list(ecdf(rt_corrected)(rt_bins)),   # P(RT ≤ each bin)
.groups = "drop"
) %>%
unnest(c(rt_bin, prob))                        # expand into one row per (bin,prob)
# 4. COMPUTE MILLER’S RACE BOUND FOR EACH PARTICIPANT & OFFSET
race_indiv <- cdf_indiv %>%
pivot_wider(
names_from  = modality,
values_from = prob
) %>%
mutate(
race_model = pmin(A + V, 1)                   # Miller bound = P(A)+P(V) capped at 1
) %>%
select(participant_number, offset_corrected, rt_bin, A, V, AVC, race_model) %>%
pivot_longer(
cols      = c(A, V, AVC, race_model),
names_to  = "condition",
values_to = "prob"
)
# 5. PLOT INDIVIDUAL PARTICIPANT CURVES
#    Thin, semi-transparent lines let you see variability across people
ggplot(race_indiv,
aes(x = rt_bin, y = prob,
color     = condition,
linetype  = condition,
group     = interaction(participant_number, condition)
)
) +
geom_line(linewidth = 0.3, alpha = 0.4) +   # individual curves
scale_color_manual(
values = c(
"A"          = "#d62728",   # red
"V"          = "#1f77b4",   # blue
"AVC"        = "darkgreen", # green
"race_model" = "black"      # bound
),
labels = c("A","V","AVC","Race Model Bound")
) +
scale_linetype_manual(
values = c("solid","solid","solid","dotted"),
labels = c("A","V","AVC","Race Model Bound")
) +
facet_wrap(~ offset_corrected, ncol = 3) +
labs(
title     = "Individual CDFs & Miller’s Race Model by Offset",
x         = "RT (ms)",
y         = "Cumulative Probability",
color     = "Condition",
linetype  = "Condition"
) +
theme_minimal(base_size = 13) +
theme(
plot.title  = element_text(hjust = 0.5),
axis.text.x = element_text(angle = 45, hjust = 1)
)
# 6. AVERAGE OVER PARTICIPANTS FOR EACH OFFSET × RT BAND × CONDITION
race_group <- race_indiv %>%
group_by(offset_corrected, rt_bin, condition) %>%
summarise(
prob = mean(prob, na.rm = TRUE),
.groups = "drop"
)
# 7. PLOT GROUP-LEVEL CURVES
#    Thicker lines trace the mean CDFs and race bound
ggplot(race_group,
aes(x = rt_bin, y = prob,
color    = condition,
linetype = condition
)
) +
geom_line(linewidth = 0.8) +               # group-average curves
scale_color_manual(
values = c(
"A"          = "#d62728",
"V"          = "#1f77b4",
"AVC"        = "darkgreen",
"race_model" = "black"
),
labels = c("A","V","AVC","Race Model Bound")
) +
scale_linetype_manual(
values = c("solid","solid","solid","dotted"),
labels = c("A","V","AVC","Race Model Bound")
) +
facet_wrap(~ offset_corrected, ncol = 3) +
labs(
title     = "Mean CDFs & Miller’s Race Model by Offset",
x         = "RT (ms)",
y         = "Cumulative Probability",
color     = "Condition",
linetype  = "Condition"
) +
theme_minimal(base_size = 13) +
theme(
plot.title  = element_text(hjust = 0.5),
axis.text.x = element_text(angle = 45, hjust = 1)
)
# 1. helper to compute empirical CDF df for any grouping
get_ecdf_df <- function(df, group_vars){
df %>%
arrange(rt_corrected) %>%
mutate(cdf = seq_along(rt_corrected) / n()) %>%
ungroup()
}
# 2. helper to build Miller bound given a little ecdf df with modalities A & V
get_miller_bound <- function(ecdf_df){
# pull A and V
A <- ecdf_df %>% filter(modality=="A")
V <- ecdf_df %>% filter(modality=="V")
# union time grid
t_grid <- sort(unique(c(A$rt_corrected, V$rt_corrected)))
# step‐function approximations
FA <- approxfun(A$rt_corrected, A$cdf, method="constant", yleft=0, yright=1, f=1)
FV <- approxfun(V$rt_corrected, V$cdf, method="constant", yleft=0, yright=1, f=1)
tibble(
rt_corrected = t_grid,
cdf          = FA(t_grid) + FV(t_grid)
)
}
# 3. loop over offsets
offsets <- sort(unique(total_df$offset_corrected))
for(off in offsets) {
df_off <- total_df %>% filter(offset_corrected == off)
# 3a. Group‐level ECDFs
group_ecdf <- df_off %>%
group_by(modality) %>%
get_ecdf_df()
miller_grp <- get_miller_bound(group_ecdf)
p_grp <- ggplot() +
geom_line(data = filter(group_ecdf, modality=="A"),
aes(rt_corrected, cdf, color="A"), linewidth=0.5) +
geom_line(data = filter(group_ecdf, modality=="V"),
aes(rt_corrected, cdf, color="V"), linewidth=0.5) +
geom_line(data = filter(group_ecdf, modality=="AVC"),
aes(rt_corrected, cdf, color="AVC"), linewidth=0.5) +
geom_line(data = miller_grp,
aes(rt_corrected, cdf),
color="black", linetype="dotted", linewidth=0.5) +
scale_color_manual(values=c("A"="red","V"="blue","AVC"="green")) +
labs(title   = paste0("Group CDFs — Offset ", off, " ms"),
x       = "RT (ms)",
y       = "CDF",
color   = "Modality") +
theme_minimal()
print(p_grp)
# 3b. Subject‐level ECDFs (faceted)
subj_ecdf <- df_off %>%
group_by(participant_number, modality) %>%
get_ecdf_df()
# Miller per subject
subj_miller <- subj_ecdf %>%
group_by(participant_number) %>%
nest() %>%
mutate(
miller = map(data, get_miller_bound)
) %>%
select(participant_number, miller) %>%
unnest(miller)
p_subj <- ggplot() +
geom_line(data = filter(subj_ecdf, modality=="A"),
aes(rt_corrected, cdf, color="A"), linewidth=0.5) +
geom_line(data = filter(subj_ecdf, modality=="V"),
aes(rt_corrected, cdf, color="V"), linewidth=0.5) +
geom_line(data = filter(subj_ecdf, modality=="AVC"),
aes(rt_corrected, cdf, color="AVC"), linewidth=0.5) +
geom_line(data = subj_miller,
aes(rt_corrected, cdf),
color="black", linetype="dotted", linewidth=0.5) +
scale_color_manual(values=c("A"="red","V"="blue","AVC"="green")) +
labs(title = paste0("Subject CDFs — Offset ", off, " ms"),
x     = "RT (ms)",
y     = "CDF",
color = "Modality") +
facet_wrap(~ participant_number) +
theme_minimal()
print(p_subj)
}
