library(ggplot2)
library(dplyr)
library(rstatix)
library(ggpubr)
library(readr)
# -------------------------------------------------------------------
# LOAD AND PREPARE INDIVIDUAL DATA
# -------------------------------------------------------------------
# Read CSV file (adjust the path as needed)
df <- read.csv("/Users/harpermarshall/Desktop/Project 1/AV_Stress_Pilot_Data/AV_Stress_PilotData_P005.csv")
# Keep only the relevant conditions
df_task <- df %>%
filter(Type %in% c("AVC", "AVI", "V", "A")) %>%  # Optional: if you want to focus on these
group_by(Type) %>%
slice_sample(n = 111) %>%   # Keep exactly 111 rows per condition
ungroup()
# Delete all incorect responses
df_task <- df_task[is.na(df_task$Correct) | df_task$Correct == "TRUE", ]
# -------------------------------------------------------------------
# GENERAL TRENDS
# -------------------------------------------------------------------
# Summary of major stats
summary_stats <- df_task %>%
group_by(Type) %>%
summarise(
mean_RT = mean(RT, na.rm = TRUE),
sd_RT = sd(RT, na.rm = TRUE),
accuracy = mean(Correct, na.rm = TRUE),
n = n()
)
print(summary_stats)
# Pairwise t-tests on RT by condition
ttest_results <- df_task %>%
t_test(RT ~ Type, paired = FALSE, var.equal = FALSE) %>%
adjust_pvalue(method = "bonferroni") %>%  # Optional: control for multiple comparisons
add_significance()
# -------------------------------------------------------------------
# LOAD AND PREPARE INDIVIDUAL DATA
# -------------------------------------------------------------------
# Read CSV file (adjust the path as needed)
df <- read.csv("/Users/harpermarshall/Desktop/Project 1/AV_Stress_Pilot_Data/AV_Stress_PilotData_P005.csv")
# Define column types (adjust if needed)
col_spec <- cols(
Block = col_double(),
Trial = col_double(),
Type = col_character(),
Visual = col_character(),
Audio = col_character(),
Response = col_character(),
RT = col_double(),
Correct = col_logical(),
ITI = col_double()
)
# -------------------------------------------------------------------
# GENERAL TRENDS
# -------------------------------------------------------------------
# Summary of major stats
summary_stats <- df_task %>%
group_by(Type) %>%
summarise(
mean_RT = mean(RT, na.rm = TRUE),
sd_RT = sd(RT, na.rm = TRUE),
accuracy = mean(Correct, na.rm = TRUE),
n = n()
)
# Set the path to your folder
data_path <- "/Users/harpermarshall/Desktop/Project 1/AV_Stress_Pilot_Data/"
# List all relevant CSV files (starting with "AV_Stress_PilotData_")
file_list <- list.files(path = data_path, pattern = "AV_Stress_PilotData_.*\\.csv", full.names = TRUE)
# Define column types (adjust if needed)
col_spec <- cols(
Block = col_double(),
Trial = col_double(),
Type = col_character(),
Visual = col_character(),
Audio = col_character(),
Response = col_character(),
RT = col_double(),
Correct = col_logical(),
ITI = col_double()
)
df_task <- file_list %>%
lapply(function(file) {
df <- read_csv(file, col_types = col_spec)
# Remove bottom 4 rows
df <- head(df, -4)
# Remove rows where RT is missing or negative
df <- df %>% filter(!is.na(RT) & RT >= 0)
# Add Participant ID from filename
df$Participant <- gsub(".*_P(\\d+)\\.csv", "P\\1", file)
return(df)
}) %>%
bind_rows()
# Delete all incorect responses
df_task <- df_task[is.na(df_task$Correct) | df_task$Correct == "TRUE", ]
# -------------------------------------------------------------------
# GENERAL TRENDS
# -------------------------------------------------------------------
# Summary of major stats
summary_stats <- df_task %>%
group_by(Type) %>%
summarise(
mean_RT = mean(RT, na.rm = TRUE),
sd_RT = sd(RT, na.rm = TRUE),
accuracy = mean(Correct, na.rm = TRUE),
n = n()
)
print(summary_stats)
# Pairwise t-tests on RT by condition
ttest_results <- df_task %>%
t_test(RT ~ Type, paired = FALSE, var.equal = FALSE) %>%
adjust_pvalue(method = "bonferroni") %>%  # Optional: control for multiple comparisons
add_significance()
print(ttest_results)
# Plot of basic RT conditions with significance markers
ggplot(df_task, aes(x = Type, y = RT)) +
geom_boxplot(fill = "skyblue") +
labs(title = "Reaction Time by Condition", x = "Condition", y = "RT (s)") +
stat_pvalue_manual(
ttest_results,
label = "p.adj.signif",
y.position = seq(max(df_task$RT) + 0.1, by = 0.1, length.out = nrow(ttest_results)),
tip.length = 0.01
) +
theme_minimal()
# Visualizes accuracy (excluding AVI since NA)
df_accuracy <- df_task %>% filter(!is.na(Correct))
ggplot(df_accuracy, aes(x = Type, fill = Correct)) +
geom_bar(position = "fill") +
labs(title = "Accuracy by Condition (excluding AVI)",
y = "Proportion",
x = "Condition Type") +
scale_y_continuous(labels = scales::percent)
# Histogram of RTs
ggplot(df_task, aes(x = RT)) +
geom_histogram(binwidth = 0.05, fill = "darkorange", color = "black") +
labs(title = "Distribution of Reaction Times")
df_task <- file_list %>%
lapply(function(file) {
df <- read_csv(file, col_types = col_spec)
# Remove bottom 4 rows
df <- head(df, -4)
# Remove rows where RT is missing or negative
df <- df %>% filter(!is.na(RT) & RT >= 0)
# Add Participant ID from filename
df$Participant <- gsub(".*_P(\\d+)\\.csv", "P\\1", file)
return(df)
}) %>%
bind_rows()
# -------------------------------------------------------------------
# GENERAL TRENDS
# -------------------------------------------------------------------
# Summary of major stats
summary_stats <- df_task %>%
group_by(Type) %>%
summarise(
mean_RT = mean(RT, na.rm = TRUE),
sd_RT = sd(RT, na.rm = TRUE),
accuracy = mean(Correct, na.rm = TRUE),
n = n()
)
print(summary_stats)
# Pairwise t-tests on RT by condition
ttest_results <- df_task %>%
t_test(RT ~ Type, paired = FALSE, var.equal = FALSE) %>%
adjust_pvalue(method = "bonferroni") %>%  # Optional: control for multiple comparisons
add_significance()
print(ttest_results)
# Plot of basic RT conditions with significance markers
ggplot(df_task, aes(x = Type, y = RT)) +
geom_boxplot(fill = "skyblue") +
labs(title = "Reaction Time by Condition", x = "Condition", y = "RT (s)") +
stat_pvalue_manual(
ttest_results,
label = "p.adj.signif",
y.position = seq(max(df_task$RT) + 0.1, by = 0.1, length.out = nrow(ttest_results)),
tip.length = 0.01
) +
