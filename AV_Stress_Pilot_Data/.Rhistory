# Visualizes accuracy (excluding AVI since NA)
df_accuracy <- df_task %>% filter(!is.na(Correct))
ggplot(df_accuracy, aes(x = Type, fill = Correct)) +
geom_bar(position = "fill") +
labs(title = "Accuracy by Condition (excluding AVI)",
y = "Proportion",
x = "Condition Type") +
scale_y_continuous(labels = scales::percent)
# Histogram of RTs
ggplot(df_task, aes(x = RT)) +
geom_histogram(binwidth = 0.05, fill = "darkorange", color = "black") +
labs(title = "Distribution of Reaction Times")
# RT over trials
ggplot(df_task, aes(x = Trial, y = RT, color = Type)) +
geom_line() +
labs(title = "RT Over Trials", x = "Trial Number", y = "Reaction Time")
# -------------------------------------------------------------------
# BLOCK COMPARISONS
# -------------------------------------------------------------------
# Create new variable for "block group"
df_task <- df_task %>%
mutate(Block_Group = if_else(Block == 4, "Block4", "OtherBlocks"))
# Quick look: Boxplot of RT by Block Group
ggplot(df_task, aes(x = Block_Group, y = RT)) +
geom_boxplot(fill = "lightblue") +
labs(title = "Reaction Times: Block 4 vs. Other Blocks")
# Add condition (type) into the mix
ggplot(df_task, aes(x = Type, y = RT, fill = Block_Group)) +
geom_boxplot(position = position_dodge(width = 0.8)) +
labs(title = "RT by Condition and Block Group", y = "Reaction Time", x = "Condition")
# -------------------------------------------------------------------
# WITHIN BLOCK 4
# -------------------------------------------------------------------
# Look at only block 4
df_block4 <- df_task %>% filter(Block == 4)
# Plot RT over time within block 4
df_block4 <- df_block4 %>%
mutate(Trial_Block4 = row_number())
# Compute pairwise t-tests on RT by condition in block 4
ttest_results_block4 <- df_block4 %>%
t_test(RT ~ Type, paired = FALSE, var.equal = FALSE) %>%
adjust_pvalue(method = "bonferroni") %>%  # Control for multiple comparisons
add_significance()
print(ttest_results_block4)
# Create a boxplot for block 4 with significance markers
ggplot(df_block4, aes(x = Type, y = RT)) +
geom_boxplot(fill = "skyblue") +
labs(title = "Reaction Time by Condition (Block 4)",
x = "Condition", y = "RT (s)") +
stat_pvalue_manual(
ttest_results_block4,
label = "p.adj.signif",
y.position = seq(max(df_block4$RT) + 0.1, by = 0.1, length.out = nrow(ttest_results_block4)),
tip.length = 0.01
) +
theme_minimal()
# How different conditions behave within Block 4
ggplot(df_block4, aes(x = Trial_Block4, y = RT, color = Type)) +
geom_smooth(method = "loess", se = FALSE) +
labs(title = "RT Trend by Condition in Block 4",
x = "Trial (Block 4)",
y = "Reaction Time (s)")
library(lme4)
library(lmerTest)
# Mixed-effects model: RT as a function of condition, with random intercepts for participants
model_conditions <- lmer(RT ~ Type + (1 | Participant), data = df_task)
summary(model_conditions)
aov_model <- aov(RT ~ Type + Error(Participant/Type), data = df_task)
summary(aov_model)
