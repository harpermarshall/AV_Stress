setwd("/Users/harpermarshall/Desktop/Project 1/AV_Stress_Data/")
# Load the combined no-offset file
df_all <- read_csv("All_Stroop_Trials_With_Survey_NoOffsets.csv") %>%
filter(Block == 2,                          # Keep only block 2
Type %in% c("A", "V", "AVI")) %>%    # Keep only A, V, and AVI trials
mutate(
modality = recode(Type, A = 1, V = 2, AVI = 3),    # Recode modality numerically
reaction_time = RT_corrected                       # Already in ms, no need to convert
) %>%
rename(
participant_number = Participant
) %>%
select(participant_number, Block, Trial, modality, Visual, Audio,
Response, reaction_time, Correct, ITI)        # Keep & reorder columns
# Save as new CSV
write_csv(df_all, "AV_Stress_PilotData_Delays_NEW.csv")
